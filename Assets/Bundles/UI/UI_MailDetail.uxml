<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="UI_Mail.uss" />
    <!-- 邮件详情：叠在邮件列表弹窗之上 -->
    <ui:VisualElement name="UI_MailDetail" picking-mode="Position" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.45); justify-content: center; align-items: center;">
        <ui:VisualElement name="UI_MailDetail_Card" style="width: 400px; max-width: 94%; height: 520px; max-height: 88%; padding-top: 14px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; background-color: rgb(36, 41, 56); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; flex-direction: column;">
            <ui:VisualElement name="UI_MailDetail_TitleRow" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-shrink: 0;">
                <ui:Button name="UI_MailDetail_BtnBack" text="‹ 返回" style="height: 32px; padding-left: 10px; padding-right: 10px; font-size: 14px; background-color: rgb(70, 78, 96); color: white; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;" />
                <ui:Button name="UI_MailDetail_BtnClose" text="×" style="width: 36px; height: 36px; font-size: 22px; background-color: rgb(89, 97, 115); color: white; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;" />
            </ui:VisualElement>
            <ui:Label name="UI_MailDetail_Title" text="标题" style="font-size: 18px; color: white; -unity-font-style: bold; white-space: normal; margin-bottom: 6px; flex-shrink: 0;" />
            <ui:Label name="UI_MailDetail_Meta" text="发送 / 过期" style="font-size: 11px; color: rgb(140, 150, 168); margin-bottom: 10px; flex-shrink: 0;" />
            <ui:ScrollView name="UI_MailDetail_Scroll" style="flex-grow: 1; margin-bottom: 10px;">
                <ui:Label name="UI_MailDetail_Body" text="正文" style="font-size: 14px; color: rgb(210, 216, 228); white-space: normal; margin-bottom: 12px;" />
                <ui:VisualElement name="UI_MailDetail_Rewards" style="flex-direction: row; flex-wrap: wrap; margin-bottom: 8px;" />
            </ui:ScrollView>
            <ui:VisualElement name="UI_MailDetail_Actions" style="flex-direction: row; justify-content: flex-end; flex-shrink: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
