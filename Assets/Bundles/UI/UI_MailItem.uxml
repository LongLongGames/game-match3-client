<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- 列表行：卡片本体 + 底部间距（留给 ListView 行高） -->
    <ui:VisualElement name="MailRow" picking-mode="Position" style="flex-direction: column; height: 100%; padding-bottom: 10px;">
        <ui:VisualElement name="Mail_Card" picking-mode="Position" style="flex-grow: 1; flex-direction: column; padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px; background-color: rgb(51, 56, 71); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
            <ui:VisualElement name="Mail_Top" style="flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                <ui:Label name="Mail_Title" text="标题" style="flex-grow: 1; flex-shrink: 1; font-size: 15px; color: white; -unity-font-style: bold; white-space: normal; margin-right: 8px;" />
                <ui:Label name="Mail_Time" text="今天" style="flex-shrink: 0; font-size: 11px; color: rgb(140, 150, 168); -unity-text-align: upper-right; min-width: 48px;" />
            </ui:VisualElement>
            <ui:Label name="Mail_Preview" text="正文预览…" style="font-size: 12px; color: rgb(170, 178, 192); white-space: normal; overflow: hidden; max-height: 36px;" />
            <ui:Label name="Mail_Badge" text="" style="font-size: 11px; color: rgb(120, 200, 140); margin-top: 4px; display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
